{
  "name": "impower-monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/link-agent-skills.mjs",
    "web:dev": "node scripts/dev-preview.mjs --mode same-origin",
    "web:dev:same-origin": "node scripts/dev-preview.mjs --mode same-origin",
    "web:dev:cross-origin": "node scripts/dev-preview.mjs --mode cross-origin",
    "vscode:dev": "npm --prefix vscode-sparkdown run watch",
    "typecheck": "node scripts/typecheck.mjs",
    "check:node-names": "node scripts/check-node-names.mjs",
    "lint:radix-boundary": "eslint --no-inline-config --max-warnings 0 \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\""
  },
  "workspaces": [
    "packages/*",
    "!packages/concept-generator",
    "impower-dev",
    "sparkdown-player-app",
    "definitions",
    "vscode-sparkdown",
    "vscode-sparkdown/scripts",
    "vscode-sparkdown/webviews/*"
  ],
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "ajv": "^8.17.1",
    "eslint": "^9.18.0",
    "eslint-plugin-yml": "^1.14.0",
    "playwright": "^1.61.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
