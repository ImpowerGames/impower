spark-web-player #game .input {
  pointer-events: auto;
  color-scheme: dark;
  line-height: 1.5;
  width: 100%;
  margin-bottom: 1rem;
  +.small {
    margin-top: -0.75rem;
    margin-bottom: 1rem;
  }
  height: 3.125rem;
  &[type="color"] {
    &::-webkit-color-swatch-wrapper {
