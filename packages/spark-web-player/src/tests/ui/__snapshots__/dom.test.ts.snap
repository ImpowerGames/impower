  }
}
spark-web-player #game .slider {
  pointer-events: auto;
  width: 100%;
  height: 1.25rem;
  border-radius: 0.25rem;
  background-color: transparent;
  cursor: pointer;
  appearance: none;
  &::-webkit-slider-runnable-track {
    width: 100%;
    height: 0.25rem;
    border-radius: 0.25rem;
    background-color: var(--theme-color-slate_30);
  }
  &::-webkit-slider-thumb {
    appearance: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background-color: var(--theme-color-slate_50);
    border-width: 0px;
    cursor: grab;
    margin-top: -0.4375rem;
    transition: background-color 0.2s ease-in-out;
  }
  &:hover {
    &::-webkit-slider-thumb {
      background-color: var(--theme-color-sky_40);
    }
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
  margin-bottom: 1rem;
}
spark-web-player #game .link {
  text-decoration-color: var(--theme-color-color-mix(in srgb, currentColor 50%, transparent));
