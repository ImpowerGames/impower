    background-position: right 0.75rem center;
    background-size: 1rem auto;
    background-repeat: no-repeat;
    padding-right: 1.75rem;
    &::-webkit-calendar-picker-indicator {
      opacity: 0;
      cursor: pointer;
    }
  }
  padding: 0.75rem 1rem;
  border-radius: 0.25rem;
  border-width: 0.0625rem;
  border-style: solid;
  border-color: var(--theme-color-slate_40);
  background-color: var(--theme-color-slate_30);
  color: var(--theme-color-slate_90);
  transition: all 0.2s ease-in-out;
  accent-color: var(--theme-color-sky_60);
  &::placeholder {
    color: var(--theme-color-slate_70);
  }
  &:focus {
    border-color: var(--theme-color-sky_40);
    box-shadow: 0 0 0 0.0625rem var(--theme-color-sky_40);
  }
  &:disabled {
    opacity: 0.5;
