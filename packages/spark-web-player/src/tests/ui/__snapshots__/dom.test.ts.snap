  }
  &:focus {
    box-shadow: 0 0 0 0.125rem rgb(14 165 233 / 37.5%);
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
