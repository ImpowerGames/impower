  }
  margin-bottom: 1rem;
}
spark-web-player #game .muted {
  color: var(--theme-color-slate_60);
}
spark-web-player #game .paragraph {
  display: block;
  margin-bottom: 1rem;
}
spark-web-player #game .small {
  font-size: 0.875em;
}
spark-web-player #game .container {
  width: 100%;
  max-width: 700px;
  margin: 0px auto;
  padding: 1rem 0px;
}
spark-web-player #game .prose {
  display: block;
  color: var(--theme-color-slate_90);
}
spark-web-player #game .strong {
  display: inline;
  font-weight: 700;
}
spark-web-player #game .emphasis {
  display: inline;
  font-style: italic;
}
spark-web-player #game .bold {
