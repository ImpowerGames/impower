  padding-left: 2.75rem;
}
spark-web-player #game .file_input {
  background-color: transparent;
  border-style: none;
  border-width: 0px;
  border-radius: 0px;
  padding: 0.375rem 0px 0.375rem 0.125rem;
  color: var(--theme-color-slate_60);
  &::file-selector-button {
    line-height: 1.5;
    background-color: var(--theme-color-slate_50);
    border-width: 0.0625rem;
    border-style: solid;
    border-color: var(--theme-color-slate_50);
    border-radius: 0.25rem;
    padding: 0.375rem 1rem;
    margin-right: 0.5rem;
    margin-left: 0px;
    color: white;
    font-size: 1rem;
    font-weight: 400;
    cursor: pointer;
    transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out;
    &:hover {
      background-color: var(--theme-color-slate_60);
      border-color: var(--theme-color-slate_60);
    }
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
}
spark-web-player #game .scroller {
  pointer-events: auto;
}
spark-web-player #game .overflow_auto {
  display: block;
  overflow-x: auto;
  width: 100%;
  pointer-events: auto;
}
spark-web-player #game .article {
  display: block;
  margin-bottom: 1rem;
  background-color: var(--theme-color-slate_30);
  border-radius: 0.25rem;
  padding: 1rem;
  >:last-child {
    margin-bottom: 0px;
  }
  >.header {
    margin: -1rem -1rem 0px;
    padding: 0.66rem 1rem;
    background-color: rgb(255 255 255 / 1.5%);
    border-bottom-width: 0.0625rem;
    border-bottom-style: solid;
    border-bottom-color: var(--theme-color-slate_30);
    border-top-left-radius: 0.25rem;
    border-top-right-radius: 0.25rem;
  }
  >.footer {
    margin: 0px -1rem -1rem;
    padding: 0.66rem 1rem;
    background-color: rgb(255 255 255 / 1.5%);
    border-top-width: 0.0625rem;
    border-top-style: solid;
    border-top-color: var(--theme-color-slate_30);
    border-bottom-left-radius: 0.25rem;
    border-bottom-right-radius: 0.25rem;
  }
  &[aria-busy="true"] {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    &::before {
      content: "";
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 50%;
      border-width: 0.125rem;
      border-style: solid;
      border-color: var(--theme-color-slate_40);
      border-top-color: var(--theme-color-sky_60);
      animation-name: spin;
      animation-duration: 0.6s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
  }
}
spark-web-player #game .header {
  display: block;
}
spark-web-player #game .footer {
  display: block;
}
spark-web-player #game .section {
  display: block;
  margin-bottom: 1rem;
}
