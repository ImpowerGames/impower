spark-web-player #game .radio {
  pointer-events: auto;
  appearance: none;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  border-width: 0.125rem;
  border-style: solid;
  border-color: var(--theme-color-slate_40);
  background-color: var(--theme-color-slate_30);
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  &:checked {
    border-width: 0.35rem;
    border-color: var(--theme-color-sky_40);
    background-color: white;
  }
  &:focus {
    border-color: var(--theme-color-sky_40);
    box-shadow: 0 0 0 0.125rem rgb(14 165 233 / 37.5%);
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
}
spark-web-player #game .switch {
  pointer-events: auto;
  appearance: none;
  width: 2.25rem;
  height: 1.25rem;
  border-radius: 1.25rem;
  background-color: var(--theme-color-slate_40);
  border-width: 0.1875rem;
  border-style: solid;
  border-color: var(--theme-color-slate_40);
  cursor: pointer;
  position: relative;
  transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out;
  &::before {
    content: "";
    position: absolute;
    top: 0px;
    left: 0px;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background-color: white;
    transition: transform 0.1s ease-in-out;
  }
  &:checked {
    background-color: var(--theme-color-sky_40);
    border-color: var(--theme-color-sky_40);
    &::before {
      transform: translateX(1rem);
