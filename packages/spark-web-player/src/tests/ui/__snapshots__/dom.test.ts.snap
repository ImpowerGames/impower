            },
            {
              "class": "style-styles",
              "style": "display: none;",
              "tag": "style",
              "text": "spark-web-player #game .main {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
  font-size: 1rem;
  line-height: 1.5;
  font-weight: 400;
  color: var(--theme-color-slate_80);
}
spark-web-player #game .layouts {
  & [data-tooltip] {
    position: relative;
    &::before {
      content: attr(data-tooltip);
      display: block;
      position: absolute;
      z-index: 99;
      bottom: 100%;
      left: 50%;
      transform: translate(-50%, -0.25rem);
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      background-color: var(--theme-color-slate_95);
      color: black;
      font-size: 0.875rem;
      font-weight: 400;
      font-style: normal;
      text-decoration: none;
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      cursor: default;
    }
    &::after {
      content: "";
      display: block;
      position: absolute;
      z-index: 99;
      bottom: 100%;
      left: 50%;
      transform: translate(-50%, 0);
      padding: 0px;
      border-radius: 0px;
      background-color: transparent;
      border-top-width: 0.3rem;
      border-top-style: solid;
      border-top-color: var(--theme-color-slate_95);
      border-right-width: 0.3rem;
      border-right-style: solid;
      border-right-color: transparent;
      border-left-width: 0.3rem;
      border-left-style: solid;
      border-left-color: transparent;
      opacity: 0;
      pointer-events: none;
      cursor: default;
    }
    &:hover::before, &:focus::before {
      opacity: 1;
      animation-name: tooltip_slide;
      animation-duration: 0.2s;
      animation-fill-mode: forwards;
    }
    &:hover::after, &:focus::after {
      opacity: 1;
      animation-name: tooltip_caret_slide;
      animation-duration: 0.2s;
      animation-fill-mode: forwards;
    }
  }
}
spark-web-player #game .row {
  display: flex;
  flex-direction: row;
}
spark-web-player #game .block {
  display: block;
}
spark-web-player #game .column {
  display: flex;
  flex-direction: column;
}
spark-web-player #game .stack {
  >* {
    position: absolute;
    inset: 0px;
  }
}
spark-web-player #game .overlay {
  position: absolute;
  inset: 0px;
}
spark-web-player #game .text {
  display: block;
  pointer-events: auto;
  user-select: none;
  text-wrap: wrap;
  white-space: pre-line;
  & * {
    display: inline;
  }
}
spark-web-player #game .stroke {
  display: block;
  pointer-events: none;
  cursor: default;
  user-select: none;
  text-wrap: wrap;
  position: absolute;
  inset: 0px;
  text-shadow: 1px 0px 0 black,0.6234898018587336px 0.7818314824680298px 0 black,-0.22252093395631434px 0.9749279121818236px 0 black,-0.900968867902419px 0.43388373911755823px 0 black,-0.9009688679024191px -0.433883739117558px 0 black,-0.2225209339563146px -0.9749279121818236px 0 black,0.6234898018587334px -0.7818314824680299px 0 black;
  color: black;
  white-space: pre-line;
  & * {
    display: inline;
  }
}
spark-web-player #game .text_line {
  display: block;
  text-wrap: wrap;
}
spark-web-player #game .text_word {
  display: inline-block;
}
spark-web-player #game .text_space {
  display: inline;
}
spark-web-player #game .image {
  display: block;
  pointer-events: auto;
  position: absolute;
  inset: 0px;
  isolation: isolate;
  will-change: transform;
  container-type: size;
  container-name: image;
  >* {
    position: absolute;
    inset: 0px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: auto 100%;
    will-change: transform;
    min-width: 100%;
  }
}
spark-web-player #game .object {
  height: 100%;
  object-fit: cover;
  visibility: hidden;
}
spark-web-player #game .mask {
  display: block;
  pointer-events: auto;
  position: absolute;
  inset: 0px;
  isolation: isolate;
  will-change: transform;
  >* {
    mix-blend-mode: plus-lighter;
    position: absolute;
    inset: 0px;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: auto 100%;
    will-change: transform;
  }
}
spark-web-player #game .loading_bar {
  z-index: 1000;
  position: relative;
  width: 100%;
  height: 4px;
}
spark-web-player #game .loading_fill {
  width: 100%;
  height: 100%;
  background-color: var(--theme-color-cyan50);
  transform: scaleX(var(--loading_progress));
  transform-origin: left;
}
spark-web-player #game .screen {
  position: absolute;
  inset: 0px;
  pointer-events: none;
  cursor: default;
  & * {
    pointer-events: none;
    cursor: default;
  }
}
spark-web-player #game .stage {
  position: absolute;
  inset: 0px;
  display: flex;
  flex-direction: column;
}
spark-web-player #game .backdrop {
  position: absolute;
  inset: 0px;
  background-position: center;
  background-size: cover;
}
spark-web-player #game .portrait {
  position: absolute;
  top: 10%;
  right: 0px;
  bottom: 0px;
  left: 0px;
  display: flex;
  flex-direction: column;
  background-size: auto 100%;
  background-position: center;
  >.image * {
    mix-blend-mode: plus-lighter;
  }
}
spark-web-player #game .choices {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  gap: 8px;
  margin-bottom: 100px;
  @container screen (max-width:640px) {
    margin-bottom: 120px;
  }
}
spark-web-player #game .choice {
  display: flex;
  flex-direction: row;
  width: 90%;
  max-width: 800px;
  background-color: rgb(0 0 0 / 65%);
  padding: 8px;
  border-radius: 8px;
  border: 1px solid;
  text-align: center;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  &:hover {
    background-color: black;
    transition: all 0.15s linear;
  }
}
spark-web-player #game .button {
  pointer-events: auto;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.5;
  padding: 0.75rem 1rem;
  &[type="submit"], &[type="reset"], &[type="button"] {
    margin-top: 0px;
    margin-bottom: 1rem;
  }
  border-radius: 0.25rem;
  border-width: 0.0625rem;
  border-style: solid;
  border-color: var(--theme-color-sky_40);
  background-color: var(--theme-color-sky_40);
  color: white;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  &:hover, &:active, &:focus {
    background-color: var(--theme-color-sky_50);
    border-color: var(--theme-color-sky_50);
  }
  &.secondary {
    background-color: var(--theme-color-slate_50);
    border-color: var(--theme-color-slate_50);
    &:focus {
      box-shadow: 0 0 0 0.125rem rgb(148 163 184 / 25%);
    }
    &:hover, &:active, &:focus {
      background-color: var(--theme-color-slate_60);
      border-color: var(--theme-color-slate_60);
    }
  }
  &.contrast {
    background-color: var(--theme-color-slate_95);
    border-color: var(--theme-color-slate_95);
    &:focus {
      box-shadow: 0 0 0 0.125rem rgb(226 232 240 / 25%);
    }
    color: black;
    &:hover, &:active, &:focus {
      background-color: white;
      border-color: white;
    }
  }
  &.outline {
    background-color: transparent;
    color: var(--theme-color-sky_60);
    border-color: var(--theme-color-sky_60);
    &:hover, &:active, &:focus {
      background-color: transparent;
      color: var(--theme-color-sky_70);
      border-color: var(--theme-color-sky_70);
    }
  }
  &.outline.secondary {
    color: var(--theme-color-slate_70);
    border-color: var(--theme-color-slate_70);
    &:hover, &:active, &:focus {
      color: var(--theme-color-slate_80);
      border-color: var(--theme-color-slate_80);
    }
  }
  &.outline.contrast {
    color: var(--theme-color-slate_90);
    border-color: var(--theme-color-slate_90);
    &:hover, &:active, &:focus {
      color: white;
      border-color: white;
    }
  }
  &:focus {
    box-shadow: 0 0 0 0.125rem rgb(14 165 233 / 37.5%);
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
  &[aria-busy="true"] {
    &::before {
      content: "";
      width: 0.75rem;
      height: 0.75rem;
      margin-right: 0.5rem;
      border-radius: 50%;
      border-width: 0.125rem;
      border-style: solid;
      border-color: rgb(255 255 255 / 40%);
      border-top-color: white;
      animation-name: spin;
      animation-duration: 0.6s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
  }
}
spark-web-player #game .field {
  width: 100%;
  pointer-events: auto;
  padding: 0.75rem 1rem;
  line-height: 1.5;
  height: 3.125rem;
  margin-bottom: 1rem;
  +.small {
    margin-top: -0.75rem;
    margin-bottom: 1rem;
  }
  border-radius: 0.25rem;
  border-width: 0.0625rem;
  border-style: solid;
  border-color: var(--theme-color-slate_40);
