  >.field, >.input, >.dropdown, >.textarea, >.button {
    margin-bottom: 0px;
  }
  margin-bottom: 1rem;
  >:first-child {
    flex: 1 1 auto;
    width: 1%;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
  }
