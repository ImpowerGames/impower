  --theme-color-neutral_10: rgb(37,37,37);
  --theme-color-neutral_20: rgb(52,52,52);
  --theme-color-neutral_30: rgb(69,69,69);
  --theme-color-neutral_40: rgb(95,95,95);
  --theme-color-neutral_50: rgb(112,112,112);
  --theme-color-neutral_60: rgb(142,142,142);
  --theme-color-neutral_70: rgb(181,181,181);
  --theme-color-neutral_80: rgb(222,222,222);
  --theme-color-neutral_90: rgb(235,235,235);
  --theme-color-neutral_95: rgb(247,247,247);
  --theme-color-neutral_99: rgb(250,250,250);
  --theme-color-neutral_100: rgb(255,255,255);
  --theme-color-black: rgb(0,0,0);
  --theme-color-white: rgb(255,255,255);
  --theme-ease-none: cubic-bezier(0,0,0,0);
