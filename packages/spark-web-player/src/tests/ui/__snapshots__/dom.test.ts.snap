    margin-bottom: 1rem;
  }
  border-radius: 0.25rem;
  border-width: 0.0625rem;
  border-style: solid;
  border-color: var(--theme-color-slate_40);
  background-color: var(--theme-color-slate_30);
  color: var(--theme-color-slate_90);
  transition: all 0.2s ease-in-out;
  resize: vertical;
  &::placeholder {
    color: var(--theme-color-slate_70);
  }
  &:focus {
    border-color: var(--theme-color-sky_40);
    box-shadow: 0 0 0 0.0625rem var(--theme-color-sky_40);
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
  &:read-only:focus {
    border-color: var(--theme-color-slate_40);
    box-shadow: none;
  }
}
spark-web-player #game .slider {
  pointer-events: auto;
  width: 100%;
  height: 1.25rem;
  border-radius: 0.25rem;
  background-color: transparent;
  cursor: pointer;
  appearance: none;
  &::-webkit-slider-runnable-track {
    width: 100%;
    height: 0.25rem;
    border-radius: 0.25rem;
    background-color: var(--theme-color-slate_30);
  }
  &::-webkit-slider-thumb {
    appearance: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background-color: var(--theme-color-slate_50);
    border-width: 0px;
    cursor: grab;
    margin-top: -0.4375rem;
    transition: background-color 0.2s ease-in-out;
  }
  &:hover {
    &::-webkit-slider-thumb {
      background-color: var(--theme-color-sky_40);
    }
  }
  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    cursor: default;
  }
  margin-bottom: 1rem;
}
spark-web-player #game .link {
  text-decoration-color: var(--theme-color-color-mix(in srgb, currentColor 50%, transparent));
  text-underline-offset: 0.125rem;
  pointer-events: auto;
  align-self: flex-start;
  display: inline-block;
  color: var(--theme-color-sky_60);
  text-decoration: underline;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
  &:hover, &:active, &:focus {
    color: var(--theme-color-sky_70);
    text-decoration-color: currentColor;
  }
  &.secondary {
    color: var(--theme-color-slate_70);
    &:hover, &:active, &:focus {
      color: var(--theme-color-slate_75);
      text-decoration-color: currentColor;
    }
  }
  &.contrast {
    color: var(--theme-color-slate_90);
    &:hover, &:active, &:focus {
      color: white;
      text-decoration-color: currentColor;
    }
  }
}
spark-web-player #game .dropdown {
  width: 100%;
  pointer-events: auto;
  appearance: none;
  color-scheme: dark;
  line-height: 1.5;
  padding: 0.75rem 1rem;
  padding-right: 2.5rem;
  margin-bottom: 1rem;
  +.small {
    margin-top: -0.75rem;
