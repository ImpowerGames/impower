    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
  }
}
spark-web-player #game .grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  display: grid;
  gap: 1rem;
}
spark-web-player #game .progress {
  display: inline-block;
  appearance: none;
  overflow: hidden;
  border-width: 0px;
  &::-webkit-progress-bar {
    background-color: transparent;
  }
  &::-webkit-progress-value {
    background-color: var(--theme-color-sky_40);
    border-radius: 0.25rem;
  }
  &:indeterminate {
    background-image: linear-gradient(to right, var(--theme-color-sky_40) 30%, var(--theme-color-slate_30) 30%);
    background-size: 150% 150%;
    animation-name: progress_indeterminate;
    animation-duration: 1s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    &::-webkit-progress-bar {
      background-color: transparent;
