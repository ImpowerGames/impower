    width: 80%;
  }
}
spark-web-player #game .action {
  position: absolute;
  inset: 0px;
  padding-left: 40px;
  padding-right: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-self: center;
  text-align: center;
}
spark-web-player #game .continue_indicator {
  opacity: 0;
  line-height: 1;
  width: 16px;
  height: 16px;
  position: absolute;
  right: 16px;
  bottom: 16px;
  font-size: 16px;
  transition: opacity 0.25s linear;
  animation: var(--theme-animation-0.5s), var(--theme-animation-infinite), var(--theme-animation-bounce);
  animation-play-state: paused;
