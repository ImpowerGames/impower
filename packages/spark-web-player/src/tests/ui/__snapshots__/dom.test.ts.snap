  }
}
spark-web-player #game .list {
  display: block;
  list-style: none;
  padding-left: 0px;
  margin-bottom: 1rem;
}
spark-web-player #game .bulleted {
  list-style-type: disc;
  padding-left: 40px;
}
spark-web-player #game .ordered_list {
  display: block;
  list-style: decimal;
  padding-left: 40px;
  margin-bottom: 1rem;
}
spark-web-player #game .item {
  display: list-item;
  margin-bottom: 0.25rem;
  &:last-child {
    margin-bottom: 0px;
  }
}
spark-web-player #game .table_header {
  display: table-header-group;
  & .header_cell {
    font-weight: 600;
    border-bottom-width: 0.1875rem;
  }
  & .cell {
    font-weight: 600;
    border-bottom-width: 0.1875rem;
  }
}
spark-web-player #game .table_body {
  display: table-row-group;
}
spark-web-player #game .table_footer {
  display: table-footer-group;
}
spark-web-player #game .table_row {
  display: table-row;
}
spark-web-player #game .table {
  display: table;
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  margin-bottom: 1rem;
}
spark-web-player #game .header_cell {
  display: table-cell;
  font-weight: 400;
  padding: 0.5rem 1rem;
  border-bottom-width: 0.0625rem;
  border-bottom-style: solid;
  border-bottom-color: var(--theme-color-slate_30);
}
spark-web-player #game .cell {
  display: table-cell;
  padding: 0.5rem 1rem;
  border-bottom-width: 0.0625rem;
  border-bottom-style: solid;
  border-bottom-color: var(--theme-color-slate_30);
}
spark-web-player #game .striped {
  >.table_body {
    >:nth-child(odd) {
      background-color: rgb(111 120 135 / 3.75%);
    }
  }
}
spark-web-player #game .figure {
  display: block;
}
spark-web-player #game .picture {
  display: block;
