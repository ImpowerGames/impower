  flex-direction: column;
  justify-content: center;
  align-self: center;
  text-align: center;
  font-weight: 700;
}
spark-web-player #game .heading {
  position: absolute;
  inset: 0px;
  padding-left: 40px;
  padding-right: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-self: center;
  text-align: center;
  font-weight: 700;
}
spark-web-player #game .transitional {
