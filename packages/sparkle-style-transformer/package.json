{
  "name": "@impower/sparkle-style-transformer",
  "displayName": "Sparkle Style Transformer",
  "description": "Transforms sparkle styling attributes into inline styles that set css variables.",
  "version": "0.0.1",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js"
    },
    "./*": {
      "import": "./dist/mjs/*"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/mjs/*"
      ]
    }
  },
  "types": "dist/mjs/index.d.ts",
  "main": "dist/mjs/index.js",
  "scripts": {
    "build": "node ./clean.js dist/mjs && tsc --module es2022 --outDir dist/mjs/ && echo {\"type\": \"module\"} > dist/mjs/package.json",
    "typecheck": "node ../../scripts/typecheck.mjs packages/sparkle-style-transformer/"
  },
  "devDependencies": {
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2"
  }
}
