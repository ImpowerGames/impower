                      "bottom": "100%",
                      "content": "",
                      "corner": "0",
                      "display": "block",
                      "left": "50%",
                      "opacity": "0",
                      "padding": "0",
                      "pointer-events": "none",
                      "position": "absolute",
                      "transform": "translate(-50%, 0)",
                      "z-index": "99",
