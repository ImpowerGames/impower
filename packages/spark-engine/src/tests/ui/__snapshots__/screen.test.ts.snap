                      "text-style": "normal",
                      "text-weight": "400",
                      "transform": "translate(-50%, -0.25rem)",
                      "z-index": "99",
                    },
                    "@hovered @after, @focused @after": {
                      "animation-duration": "0.2s",
                      "animation-fill-mode": "forwards",
                      "animation-name": "tooltip_caret_slide",
                      "opacity": "1",
                    },
                    "@hovered @before, @focused @before": {
                      "animation-duration": "0.2s",
                      "animation-fill-mode": "forwards",
                      "animation-name": "tooltip_slide",
                      "opacity": "1",
