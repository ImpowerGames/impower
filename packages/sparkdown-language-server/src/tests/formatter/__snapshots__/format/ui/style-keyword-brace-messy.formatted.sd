style button as base {
  cursor = pointer
  &.secondary { background-color = slate_50 }
  > text.label = { text-weight = 600; color = white }
  @hovered, @pressed {
    background-color = sky_50
  }
  @screen-size(sm) {
    width = 100%
    > text { font-size = 12px }
  }
}

style blue { text-color = white; corner = 8px }

style empty {}
