store difficulty = "easy"

function go_back() end

layout settings   in   hud as base{
column.menu   #child-gap=16   {
      text .title "Settings"
  row{button "Back" @click=go_back;button "Apply" @click=save}
        row.empty   {   }
          dropdown   #value={difficulty}   @change={difficulty = event.value}   {
  option "Easy"
                option "Hard"
        }
 -- a comment in a block
    }
      if difficulty == "hard" then
  text "Good luck"
        end
}

layout badge{text "New"}
