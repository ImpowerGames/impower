          },
          "background-color": "transparent",
          "border-style": "none",
          "border-width": "0",
          "corner": "0",
          "padding": "0.375rem 0 0.375rem 0.125rem",
          "text-color": "slate_60"
        },
        "foldout": {
          "$name": "foldout",
