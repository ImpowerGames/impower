          },
          "@focused": {
            "border-color": "sky_40",
            "shadow": "0 0 0 0.0625rem var(--theme-color-sky_40)"
          },
          "@placeholder": {
            "text-color": "slate_70"
          },
          "@readonly @focused": {
            "border-color": "slate_40",
            "shadow": "none"
          },
          "@type_color": {
            "@swatch": {
              "border-width": "0",
