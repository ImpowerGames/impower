              "text-color": "slate_75",
              "text-decoration-color": "currentColor"
            },
            "text-color": "slate_70"
          },
          "@hovered, @pressed, @focused": {
            "text-color": "sky_70",
            "text-decoration-color": "currentColor"
          },
          "align-self": "start",
          "cursor": "pointer",
          "display": "inline-block",
