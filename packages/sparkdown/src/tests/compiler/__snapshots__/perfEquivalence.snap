          },
          "@disabled": {
            "cursor": "not-allowed",
            "opacity": "0.5",
            "pointer-events": "none"
          },
          "@focused": {
            "border-color": "sky_40",
            "shadow": "0 0 0 0.125rem rgb(14 165 233 / 37.5%)"
          },
          "appearance": "none",
          "background-color": "slate_30",
          "border-color": "slate_40",
          "border-style": "solid",
          "border-width": "0.125rem",
