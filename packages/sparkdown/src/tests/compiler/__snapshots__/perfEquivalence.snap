          "padding": "0.375rem",
          "text-color": "slate_20",
          "text-leading": "normal",
          "text-size": "0.875rem",
          "text-weight": "700"
        },
        "label": {
          "$name": "label",
          "$type": "style",
          "> input, > slider, > dropdown, > textarea": {
            "margin-top": "0.25rem"
          },
          "margin-bottom": "0.375rem",
          "pointer_events": "auto",
          "text-weight": "400"
        },
        "layouts": {
          "$name": "layouts",
          "$type": "style",
          "& >> #tooltip": {
            "@after": {
              "background-color": "transparent",
              "border-left-color": "transparent",
              "border-left-style": "solid",
              "border-left-width": "0.3rem",
              "border-right-color": "transparent",
