          "padding": "0"
        },
        "figure": {
          "$name": "figure",
          "$type": "style",
          "display": "block"
        },
        "file_input": {
          "$name": "file_input",
          "$type": "style",
          "@disabled": {
            "cursor": "not-allowed",
            "opacity": "0.5",
            "pointer-events": "none"
          },
          "@file_button": {
            "@hovered": {
              "background-color": "slate_60",
              "border-color": "slate_60"
            },
            "background-color": "slate_50",
            "border-color": "slate_50",
