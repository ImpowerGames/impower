          "background-position": "left 1.125rem center",
          "background-repeat": "no-repeat",
          "background-size": "1rem auto",
          "corner": "5rem",
          "padding-left": "2.75rem"
        },
        "section": {
          "$name": "section",
          "$type": "style",
          "display": "block",
          "margin-bottom": "1rem"
        },
        "slider": {
          "$name": "slider",
          "$type": "style",
          "@disabled": {
            "cursor": "not-allowed",
            "opacity": "0.5",
            "pointer-events": "none"
          },
          "@pressed": {
            "@thumb": {
              "transform": "scale(1.25)"
            }
          },
          "@pressed, @focused": {
            "@thumb": {
              "background-color": "sky_40"
            },
            "@track": {
              "background-color": "slate_40"
            }
          },
          "@thumb": {
            "appearance": "none",
            "background-color": "slate_50",
            "border-color": "slate_20",
            "border-style": "solid",
            "border-width": "2px",
            "corner": "50%",
            "cursor": "pointer",
            "height": "1.25rem",
            "margin-top": "-0.4375rem",
            "transition": "background-color 0.2s ease-in-out, transform 0.2s ease-in-out",
            "width": "1.25rem"
          },
          "@track": {
            "background-color": "slate_30",
            "background-image": "linear-gradient(to right, var(--theme-color-sky_40) var(--_fill-percentage, 0%), transparent var(--_fill-percentage, 0%))",
            "corner": "0.25rem",
            "height": "0.375rem",
            "transition": "background-color 0.2s ease-in-out",
            "width": "100%"
          },
          "appearance": "none",
          "background-color": "transparent",
          "corner": "0.25rem",
          "cursor": "pointer",
          "height": "1.25rem",
          "pointer_events": "auto",
          "width": "100%"
        },
