          "justify-self": "start",
          "padding": "0.375rem",
          "text-color": "slate_20",
          "text-leading": "normal",
          "text-size": "0.875rem",
          "text-weight": "700"
        },
        "label": {
          "$name": "label",
          "$type": "style",
          "> input, > slider, > dropdown, > textarea": {
            "margin-top": "0.25rem"
          },
          "margin-bottom": "0.375rem",
          "pointer_events": "auto",
          "text-weight": "400"
        },
        "layouts": {
          "$name": "layouts",
          "$type": "style",
          "& >> #tooltip": {
            "@after": {
              "background-color": "transparent",
              "border-left-color": "transparent",
              "border-left-style": "solid",
              "border-left-width": "0.3rem",
              "border-right-color": "transparent",
              "border-right-style": "solid",
              "border-right-width": "0.3rem",
              "border-top-color": "slate_95",
              "border-top-style": "solid",
              "border-top-width": "0.3rem",
              "bottom": "100%",
              "content": "",
              "corner": "0",
              "display": "block",
              "left": "50%",
              "opacity": "0",
              "padding": "0",
              "pointer-events": "none",
              "position": "absolute",
              "transform": "translate(-50%, 0)",
              "z-index": "99"
            },
            "@before": {
              "background-color": "slate_95",
              "bottom": "100%",
              "content": "attr(data-tooltip)",
              "corner": "0.25rem",
              "display": "block",
              "left": "50%",
              "opacity": "0",
              "padding": "0.25rem 0.5rem",
              "pointer-events": "none",
              "position": "absolute",
              "text-color": "black",
              "text-decoration": "none",
              "text-overflow": "ellipsis",
              "text-size": "0.875rem",
              "text-style": "normal",
              "text-weight": "400",
              "transform": "translate(-50%, -0.25rem)",
              "z-index": "99"
            },
            "@hovered @after, @focused @after": {
              "animation-duration": "0.2s",
              "animation-fill-mode": "forwards",
              "animation-name": "tooltip_caret_slide",
              "opacity": "1"
            },
            "@hovered @before, @focused @before": {
              "animation-duration": "0.2s",
              "animation-fill-mode": "forwards",
              "animation-name": "tooltip_slide",
              "opacity": "1"
            },
            "pointer_events": "auto",
            "position": "relative"
          },
          "& >> @busy": {
            "@before": {
              "animation-duration": "0.75s",
              "animation-iteration-count": "infinite",
              "animation-name": "spin",
              "animation-timing-function": "linear",
              "border-color": "transparent",
              "border-style": "solid",
              "border-top-color": "var(--spinner-color, var(--theme-color-slate_65))",
              "border-width": "0.1667em",
              "content": "",
              "corner": "50%",
              "display": "inline-block",
              "height": "1em",
              "vertical-align": "-0.125em",
              "width": "1em"
            }
          }
        },
        "legend": {
          "$name": "legend",
          "$type": "style",
          "margin-bottom": "0.5rem",
          "padding": "0",
          "text-weight": "600"
        },
        "link": {
          "$name": "link",
          "$type": "style",
          "&.contrast": {
            "@hovered, @pressed, @focused": {
              "text-color": "white",
              "text-decoration-color": "currentColor"
            },
            "text-color": "slate_90"
          },
          "&.secondary": {
