      "style": {
        "$default": {
          "$name": "$default",
          "$recursive": true,
          "$type": "style"
        },
        "abbreviation": {
          "$name": "abbreviation",
          "$type": "style",
          "align-self": "start",
          "border-bottom-style": "dotted",
          "border-bottom-width": "0.0625rem",
          "cursor": "help",
          "display": "inline-block",
          "justify-self": "start",
          "text-leading": "normal"
        },
        "action": {
          "$name": "action",
          "$type": "style",
          "align_self": "center",
          "display": "flex",
          "flex_direction": "column",
          "inset": "0",
          "justify_content": "center",
          "padding_left": "40px",
          "padding_right": "40px",
          "position": "absolute",
          "text_align": "center"
        },
        "article": {
          "$name": "article",
          "$type": "style",
          "> :last-child": {
            "margin-bottom": "0"
          },
          "> footer": {
            "background-color": "rgb(255 255 255 / 1.5%)",
            "border-top-color": "slate_30",
            "border-top-style": "solid",
            "border-top-width": "0.0625rem",
            "corner-bottom-left": "0.25rem",
            "corner-bottom-right": "0.25rem",
            "margin": "0 -1rem -1rem",
            "padding": "0.66rem 1rem"
          },
          "> header": {
            "background-color": "rgb(255 255 255 / 1.5%)",
            "border-bottom-color": "slate_30",
            "border-bottom-style": "solid",
            "border-bottom-width": "0.0625rem",
            "corner-top-left": "0.25rem",
            "corner-top-right": "0.25rem",
            "margin": "-1rem -1rem 0",
            "padding": "0.66rem 1rem"
          },
          "@busy": {
            "child-align": "center",
            "child-justify": "center",
            "display": "flex",
            "min-height": "3.5rem"
          },
          "background-color": "slate_30",
          "corner": "0.25rem",
          "display": "block",
          "margin-bottom": "1rem",
          "padding": "1rem"
        },
        "backdrop": {
          "$name": "backdrop",
          "$type": "style",
          "background_position": "center",
          "background_size": "cover",
          "inset": "0",
          "position": "absolute"
        },
        "badge": {
          "$name": "badge",
          "$type": "style",
          "background-color": "sky_60",
          "child-align": "center",
          "child-justify": "center",
          "child-layout": "row",
          "corner": "1rem",
          "display": "flex",
          "padding": "0.125rem 0.5rem",
          "text-color": "white",
          "text-size": "0.75rem",
          "text-weight": "600"
        },
        "block": {
          "$name": "block",
          "$type": "style",
          "display": "block"
        },
        "bold": {
          "$name": "bold",
          "$type": "style",
          "text-weight": "700"
        },
        "bulleted": {
          "$name": "bulleted",
          "$type": "style",
          "list-style-type": "disc",
          "padding-left": "40px"
        },
        "button": {
          "$name": "button",
          "$type": "style",
          "&.contrast": {
            "@focused": {
              "shadow": "0 0 0 0.125rem rgb(226 232 240 / 25%)"
            },
            "@hovered, @pressed, @focused": {
              "background-color": "white",
              "border-color": "white"
            },
            "background-color": "slate_95",
            "border-color": "slate_95",
            "text-color": "black"
          },
          "&.outline": {
            "@hovered, @pressed, @focused": {
              "background-color": "transparent",
              "border-color": "sky_70",
              "text-color": "sky_70"
            },
            "background-color": "transparent",
            "border-color": "sky_60",
            "text-color": "sky_60"
          },
          "&.outline.contrast": {
            "@hovered, @pressed, @focused": {
              "border-color": "white",
              "text-color": "white"
            },
            "border-color": "slate_90",
            "text-color": "slate_90"
          },
          "&.outline.secondary": {
            "@hovered, @pressed, @focused": {
              "border-color": "slate_80",
              "text-color": "slate_80"
            },
            "border-color": "slate_70",
            "text-color": "slate_70"
          },
          "&.secondary": {
            "@focused": {
              "shadow": "0 0 0 0.125rem rgb(148 163 184 / 25%)"
            },
            "@hovered, @pressed, @focused": {
              "background-color": "slate_60",
              "border-color": "slate_60"
            },
            "background-color": "slate_50",
            "border-color": "slate_50"
          },
          "@busy": {
            "@before": {
              "margin-right": "0.5rem",
              "spinner-color": "white"
            }
          },
          "@disabled": {
            "cursor": "not-allowed",
            "opacity": "0.5",
            "pointer-events": "none"
          },
          "@focused": {
            "shadow": "0 0 0 0.125rem rgb(14 165 233 / 37.5%)"
          },
          "@hovered, @pressed, @focused": {
            "background-color": "sky_50",
            "border-color": "sky_50"
          },
          "@type_submit, @type_reset, @type_button": {
            "margin-bottom": "1rem",
            "margin-top": "0"
          },
          "background-color": "sky_40",
          "border-color": "sky_40",
          "border-style": "solid",
          "border-width": "0.0625rem",
          "child-align": "center",
          "child-justify": "center",
          "child-layout": "row",
          "corner": "0.25rem",
          "cursor": "pointer",
          "display": "inline-flex",
          "padding": "0.75rem 1rem",
          "pointer_events": "auto",
          "text-align": "center",
          "text-color": "white",
          "text-leading": "1.5",
          "text-weight": "400",
          "transition": "all 0.2s ease-in-out"
        },
        "caption": {
          "$name": "caption",
          "$type": "style",
          "> *": {
            "display": "inline"
          },
          "display": "block",
          "padding": "0.5rem 0",
          "text-color": "slate_60",
          "width": "100%"
        },
        "card": {
          "$name": "card",
          "$type": "style",
          "background-color": "slate_30",
          "border-color": "slate_40",
          "border-style": "solid",
          "border-width": "0.0625rem",
          "child-gap": "1rem",
          "child-layout": "column",
          "corner": "0.5rem",
          "display": "flex",
          "padding": "1.5rem"
        },
        "cell": {
          "$name": "cell",
          "$type": "style",
          "border-bottom-color": "slate_30",
          "border-bottom-style": "solid",
          "border-bottom-width": "0.0625rem",
          "display": "table-cell",
          "padding": "0.5rem 1rem"
        },
        "character_info": {
          "$name": "character_info",
          "$type": "style",
          "@screen_size(sm)": {
            "font_size": "1.5rem"
          },
          "align_items": "flex-end",
          "display": "flex",
          "flex_direction": "row",
          "font_size": "1.875rem",
          "gap": "8px",
          "justify_content": "center",
          "line_height": "1"
        },
        "character_name": {
          "$name": "character_name",
          "$type": "style",
          "font_weight": "600",
          "padding_bottom": "8px"
        },
        "character_parenthetical": {
          "$name": "character_parenthetical",
          "$type": "style",
