            {
              "offset": 0.75,
              "opacity": "0",
              "transform": "scale(2)"
            },
            {
              "offset": 1,
              "opacity": "0",
              "transform": "scale(2)"
            }
          ],
          "target": {
            "$name": "self",
            "$type": "layer"
          },
          "timing": {
            "delay": 0,
            "direction": "normal",
            "duration": 0,
            "easing": "ease",
            "fill": "both",
            "iterations": 1
          }
        },
        "progress_indeterminate": {
          "$name": "progress_indeterminate",
