          "child-justify": "center",
          "display": "none",
          "height": "100%",
          "height-max": "100%",
          "margin": "0",
          "padding": "1rem",
          "position": "fixed",
          "text-color": "slate_90",
          "width": "100%",
          "width-max": "100%",
          "z": "999"
        },
        "muted": {
          "$name": "muted",
