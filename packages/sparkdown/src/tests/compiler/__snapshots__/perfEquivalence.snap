            },
            "text-decoration": "none"
          },
          "child-align": "center",
          "child-gap": "1rem",
          "child-layout": "row",
          "display": "flex"
        },
        "object": {
          "$name": "object",
          "$type": "style",
          "height": "100%",
          "object_fit": "cover",
          "visibility": "hidden"
