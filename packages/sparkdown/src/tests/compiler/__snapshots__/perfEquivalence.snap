        "shaky": {
          "$name": "shaky",
          "$type": "animation",
          "keyframes": [
            {
              "left": "calc(1em / 60)",
              "top": "calc(1em / 60)"
            },
            {
              "left": "calc(-1em / 60)",
              "top": "calc(-2em / 60)"
            },
            {
              "left": "calc(-2em / 60)",
              "top": "calc(0em / 60)"
