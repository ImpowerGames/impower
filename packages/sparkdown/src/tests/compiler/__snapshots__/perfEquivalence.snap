          "corner": "1rem",
          "display": "flex",
          "padding": "0.125rem 0.5rem",
          "text-color": "white",
          "text-size": "0.75rem",
          "text-weight": "600"
        },
        "block": {
          "$name": "block",
          "$type": "style",
          "display": "block"
        },
        "bold": {
          "$name": "bold",
          "$type": "style",
          "text-weight": "700"
        },
        "bulleted": {
          "$name": "bulleted",
          "$type": "style",
          "list-style-type": "disc",
          "padding-left": "40px"
        },
        "button": {
          "$name": "button",
          "$type": "style",
          "&.contrast": {
            "@focused": {
              "shadow": "0 0 0 0.125rem rgb(226 232 240 / 25%)"
            },
            "@hovered, @pressed, @focused": {
              "background-color": "white",
              "border-color": "white"
            },
            "background-color": "slate_95",
            "border-color": "slate_95",
            "text-color": "black"
          },
          "&.outline": {
            "@hovered, @pressed, @focused": {
              "background-color": "transparent",
              "border-color": "sky_70",
              "text-color": "sky_70"
            },
            "background-color": "transparent",
            "border-color": "sky_60",
            "text-color": "sky_60"
          },
          "&.outline.contrast": {
            "@hovered, @pressed, @focused": {
              "border-color": "white",
              "text-color": "white"
            },
            "border-color": "slate_90",
            "text-color": "slate_90"
          },
          "&.outline.secondary": {
            "@hovered, @pressed, @focused": {
              "border-color": "slate_80",
              "text-color": "slate_80"
            },
            "border-color": "slate_70",
            "text-color": "slate_70"
          },
          "&.secondary": {
            "@focused": {
              "shadow": "0 0 0 0.125rem rgb(148 163 184 / 25%)"
            },
            "@hovered, @pressed, @focused": {
              "background-color": "slate_60",
              "border-color": "slate_60"
            },
            "background-color": "slate_50",
            "border-color": "slate_50"
          },
          "@busy": {
            "@before": {
              "margin-right": "0.5rem",
              "spinner-color": "white"
            }
          },
          "@disabled": {
            "cursor": "not-allowed",
            "opacity": "0.5",
            "pointer-events": "none"
          },
          "@focused": {
            "shadow": "0 0 0 0.125rem rgb(14 165 233 / 37.5%)"
          },
          "@hovered, @pressed, @focused": {
            "background-color": "sky_50",
            "border-color": "sky_50"
          },
          "@type_submit, @type_reset, @type_button": {
            "margin-bottom": "1rem",
            "margin-top": "0"
          },
          "background-color": "sky_40",
          "border-color": "sky_40",
