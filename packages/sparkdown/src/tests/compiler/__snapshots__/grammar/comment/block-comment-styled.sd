scene start
  Go *far /*n*/ away* home
  Go **far /*n*/ away** home
  Go ***far /*n*/ away*** home
  Go _far /*n*/ away_ home
  Go ^far /*n*/ away^ home
  Go ~~far /*n*/ away~~ home
  Go ::far /*n*/ away:: home
  Go *//*n*/ home
  Go *italic*/* n */ after
  Go *a*/ b
  Go *x /* open
  still */ y* home
  Go *far // note* home
  choose
    + Go *far /*n*/ away* home
      done
    + Go **far /*n*/ away** home
      done
    + Go ***far /*n*/ away*** home
      done
    + Go _far /*n*/ away_ home
      done
    + Go ^far /*n*/ away^ home
      done
    + Go ~~far /*n*/ away~~ home
      done
    + Go ::far /*n*/ away:: home
      done
    + Go *a*/ b
      done
    + Go *x /* open
      still */ y* home
      done
  end
end
