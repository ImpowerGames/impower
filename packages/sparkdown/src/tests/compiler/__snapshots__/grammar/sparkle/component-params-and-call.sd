component stat_row(label, value) {
  row {
    text "{label}"
    text "{value}"
  }
}

component card(title) {
  box {
    text "{title}"
    slot
    slot.footer
  }
}

layout sheet {
  card("Inventory") {
    text "10 / 20 slots"
    fill.footer {
      button "Sort" @click=sort_bag
    }
  }
  stat_row(hero.name, hero.hp)
}
