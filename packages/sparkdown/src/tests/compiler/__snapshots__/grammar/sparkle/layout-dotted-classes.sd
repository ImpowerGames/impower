layout main {
  stage {
    mask.shadow_1
    choice.0 {
      text
    }
    button.primary.large "Save" @click=save
    row.hud #gap=12 {
      text.title "Hi"
    }
  }
}

style card {
  &.secondary {
    color = blue
  }
  > text.label {
    color = red
  }
  &.outline.secondary { color = green }
}
