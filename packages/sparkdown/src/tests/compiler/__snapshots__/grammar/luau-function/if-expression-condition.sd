function f(c, n)
  if if c then 1 else nil then
    n = 1
  elseif if c then nil else 2 then
    n = 2
  end
  while if n < 3 then true else false do
    n += 1
  end
  local v = if if c then false else true then 10 else 20
  if if c then nil elseif not n then 3 else nil then
    n = 3
  end
  local w = if c then 1 elseif function(l0)
    return l0
  end then 2 else 3
end
