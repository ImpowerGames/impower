style card {
  @nth-child(2n of icon, note>badge) {
    color = red
  }
  @nth-last-child(odd) {
    color = red
  }
  @nth-child(1 of @hovered) {
    color = red
  }
  @host(icon) {
    color = red
  }
  @host-context(panel) {
    color = red
  }
  @is(icon, note) {
    color = red
  }
  @nth-child-x(1) {
    color = red
  }
}
