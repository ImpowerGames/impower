style --[=[ example ]] inside ]=] banner {
  color = red
}
style --[==[ a ]=] b ]] c ]==] other {
  color = blue
}
style --[=[a]]=] third {
  color = green
}
style --[====[c]====] fourth {
  color = green
}
function --[=[a]]=] h(x: number) return x end

scene start
  The rain stops on the rooftop.
end
