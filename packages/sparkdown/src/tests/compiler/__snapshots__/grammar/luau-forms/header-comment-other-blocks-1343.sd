define --[[ c ]] Person with
  name = "a"
end
animation --[=[ c ]=] fade {
  keyframes {
    from { opacity = 0 }
  }
}
theme --[[ a]b ]] t {
  colors { primary = red }
}
morph --[[ c ]] --[[ d ]] m {
  method = bend
  keyframes {
    { offset = 0; eyes { state = eyes.open } }
    { offset = 0.4; eyes { state = eyes.closed } }
  }
}
screen --[[ c ]] hud {
}
external --[[ c ]] message(x)
scene start
  Hi.
end
