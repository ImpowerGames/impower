store s = "Hello, World!"
store whitespace = "  hi  "
store ab = "ab"
store x = "x"
store n = "42"
scene start
  -> main
end
scene main
  {s:upper()}
  {s:lower()}
  {s:len()}
  {s:reverse()}
  {s:sub(2, 5)}
  {s:sub(-3)}
  {whitespace:trim()}
  {s:startswith("Hello")}
  {s:endswith("!")}
  {s:find("World")}
  {s:find("zzz")}
  {s:gsub("World", "Luau")}
  {ab:rep(3)}
  {x:rep(3, "-")}
  {n:padstart(5, "0")}
  {n:padend(5, "_")}
  {s:at(1)}
  {s:at(-1)}
  done
end
