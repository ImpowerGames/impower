define component with
  ["$recursive"] = true
end

define theme with
  ["$recursive"] = true
end

define style with
  ["$recursive"] = true
end

style main with
  text-font = "system-ui, -apple-system, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\""
  text-size = 1rem
  text-leading = 1.5
  text-weight = 400
  text-color = slate_80
end

style row with
  display = flex
  flex_direction = row
end

style column with
  display = flex
  flex_direction = column
end

style stack with
  > *:
    position = absolute
    inset = 0
end

style overlay with
  position = absolute
  inset = 0
end

style text with
  display = block
  pointer_events = auto
  user_select = none
  text_wrap = wrap
  white_space = pre-line
  >> *:
    display = inline
end

style stroke with
  display = block
  pointer_events = none
  user_select = none
  text_wrap = wrap
  position = absolute
  inset = 0
  text_stroke = 1
  color = black
  white_space = pre-line
  >> *:
    display = inline
end

style text_line with
  display = block
  text_wrap = wrap
end

style text_word with
  display = inline-block
end

style text_space with
  display = inline
end

style text_letter with
end

style image with
  display = block
  pointer_events = auto
  position = absolute
  inset = 0
  isolation = isolate
  will_change = transform
  container_type = size
  container_name = image
  > *:
    position = absolute
    inset = 0
    background_position = center
    background_repeat = no-repeat
    background_size = auto 100%
    will_change = transform
    min_width = 100%
    width = fit-content
    translate = calc(0.5 * (100cqw - 100%)) 0
end

style object with
  height = 100%
  object_fit = cover
  visibility = hidden
end

style mask with
  display = block
  pointer_events = auto
  position = absolute
  inset = 0
  isolation = isolate
  will_change = transform
  > *:
    mix_blend_mode = plus-lighter
    position = absolute
    inset = 0
    mask_position = center
    mask_repeat = no-repeat
    mask_size = auto 100%
    will_change = transform
end

style loading_bar with
  z_index = 1000
  position = relative
  width = 100%
  height = 4px
end

style loading_fill with
  width = 100%
  height = 100%
  background_color = cyan50
  transform = scaleX(var(--loading_progress))
  transform_origin = left
end

style screen with
  position = absolute
  inset = 0
  pointer_events = none
  >> *:
    pointer_events = none
end

style stage with
  position = absolute
  inset = 0
  display = flex
  flex_direction = column
end

style backdrop with
  position = absolute
  inset = 0
  background_position = center
  background_size = cover
end

style portrait with
  position = absolute
  top = 10%
  right = 0
  bottom = 0
  left = 0
  display = flex
  flex_direction = column
  background_size = auto 100%
  background_position = center
  > image >> *:
    mix_blend_mode = plus-lighter
end

style choices with
  position = relative
  flex = 1
  display = flex
  flex_direction = column
  align_items = center
  justify_content = center
  width = 100%
  gap = 8px
  margin_bottom = 100px
  @screen_size(sm):
    margin_bottom = 120px
end

style choice with
  display = flex
  flex_direction = row
  width = 90%
  max_width = 800px
  background_color = rgb(0 0 0 / 65%)
  padding = 8px
  border_radius = 8px
  border = 1px solid
  text_align = center
  align_items = center
  justify_content = center
  cursor = pointer
  @hovered:
    background_color = black
    transition = all 0.15s linear
end

style button with
  display = flex
  child-layout = row
  child-align = center
  child-justify = center
  text-align = center
  padding = 0.75rem 1rem
  corner = 0.25rem
  border-width = 0.0625rem
  border-style = solid
  border-color = sky_60
  background-color = sky_60
  text-color = white
  text-weight = 500
  cursor = pointer
  transition = all 0.2s ease-in-out
  @hovered:
    background-color = sky_70
    border-color = sky_70
  -- Variants as COMPOUND selectors (`&.secondary`), so they compose: `outline`
  -- combined with a colour variant takes that variant's colour. A CSS custom
  -- property would be the other way to do this, but `--name = …` is not
  -- authorable — `--` opens a comment in a struct body.
  &.secondary:
    background-color = slate_50
    border-color = slate_50
    @hovered:
      background-color = slate_60
      border-color = slate_60
  &.contrast:
    background-color = slate_90
    border-color = slate_90
    text-color = slate_20
    @hovered:
      background-color = slate_80
      border-color = slate_80
  &.outline:
    background-color = transparent
    text-color = sky_60
    border-color = sky_60
    @hovered:
      background-color = transparent
      text-color = sky_70
      border-color = sky_70
  &.outline.secondary:
    text-color = slate_50
    border-color = slate_50
    @hovered:
      text-color = slate_60
      border-color = slate_60
  &.outline.contrast:
    text-color = slate_90
    border-color = slate_90
    @hovered:
      text-color = slate_80
      border-color = slate_80
  @focused:
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
  -- Busy state: `button "Save" #aria-busy={saving}` grows a spinner, matching
  -- Pico. `@busy` is the alias for `[aria-busy="true"]` (a raw `#a=v` can't be
  -- used as a selector — that's the inline prop syntax). `spin` is a builtin
  -- @keyframes.
  @busy:
    cursor = progress
    @before:
      content = ""
      width = 0.75rem
      height = 0.75rem
      margin-right = 0.5rem
      corner = 50%
      border-width = 0.125rem
      border-style = solid
      border-color = rgb(255 255 255 / 40%)
      border-top-color = white
      animation-name = spin
      animation-duration = 0.6s
      animation-timing-function = linear
      animation-iteration-count = infinite
end

style field with
  padding = 0.75rem 1rem
  corner = 0.25rem
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
  background-color = slate_30
  text-color = slate_90
  transition = all 0.2s ease-in-out
  @focused:
    border-color = sky_60
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
end

style checkbox with
  width = 1.25rem
  height = 1.25rem
  cursor = pointer
  accent-color = sky_60
end

-- `input` is the generic form control (`input #type="email|search|date|…"`).
-- It needs the same chrome as `field`, which is just `input #type="text"` under
-- a friendlier name — without this, every typed input fell back to the
-- browser's white default while `field` next to it was dark.
style input with
  padding = 0.75rem 1rem
  corner = 0.25rem
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
  background-color = slate_30
  text-color = slate_90
  accent-color = sky_60
  transition = all 0.2s ease-in-out
  @focused:
    border-color = sky_60
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
end

style radio with
  width = 1.25rem
  height = 1.25rem
  cursor = pointer
  accent-color = sky_60
end

-- A `switch` is a checkbox carrying role="switch". Pico draws it as a pill
-- TRACK with a sliding THUMB rather than a box, so the native checkbox
-- appearance is dropped and the thumb is an `@before` pseudo-element that
-- translates across on `@checked`.
style switch with
  appearance = none
  width = 2.25rem
  height = 1.25rem
  corner = 0.625rem
  background-color = slate_40
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
  cursor = pointer
  position = relative
  transition = background-color 0.2s ease-in-out
  @before:
    content = ""
    position = absolute
    top = 0.125rem
    left = 0.125rem
    width = 0.875rem
    height = 0.875rem
    corner = 50%
    background-color = white
    transition = transform 0.2s ease-in-out
  @checked:
    background-color = sky_60
    border-color = sky_60
    @before:
      transform = translateX(1rem)
  @focused:
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
end

style textarea with
  padding = 0.75rem 1rem
  corner = 0.25rem
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
  background-color = slate_30
  text-color = slate_90
  transition = all 0.2s ease-in-out
  @focused:
    border-color = sky_60
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
end

style slider with
  width = 200px
  cursor = pointer
  accent-color = sky_60
end

style link with
  display = inline-block
  text-color = sky_60
  text-decoration = underline
  cursor = pointer
  transition = all 0.2s ease-in-out
  @hovered:
    text-color = sky_70
  &.secondary:
    text-color = slate_50
    @hovered:
      text-color = slate_60
  &.contrast:
    text-color = slate_90
    @hovered:
      text-color = slate_80
end

style dropdown with
  padding = 0.75rem 1rem
  corner = 0.25rem
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
  background-color = slate_30
  text-color = slate_90
  cursor = pointer
  transition = all 0.2s ease-in-out
  @focused:
    border-color = sky_60
    shadow = 0 0 0 0.125rem rgb(14 165 233 / 37.5%)
end

style option with
  background-color = slate_30
  text-color = slate_90
end

-- Pico UI component classes ------------------------------------------------

style h1 with
  text-size = 2rem
  text-weight = 700
  text-leading = 1.125
end

style h2 with
  text-size = 1.5rem
  text-weight = 700
  text-leading = 1.2
end

style h3 with
  text-size = 1.25rem
  text-weight = 700
end

style h4 with
  text-size = 1.125rem
  text-weight = 700
end

style h5 with
  text-size = 1rem
  text-weight = 700
end

style h6 with
  text-size = 0.875rem
  text-weight = 700
end

style muted with
  text-color = slate_60
end

style small with
  text-size = 0.875rem
end

style container with
  width = 100%
  width-max = 40rem
  margin = 0 auto
  padding = 1rem
end

-- Inline text CLASSES -------------------------------------------------------
--
-- Applied to a whole text element (`text bold "Bold"`, like `text h1`). For
-- styling WITHIN a line, use rich-text tags: `text "a <b>bold</b> word"`.

-- A block of flowing prose. The overlay lays everything out as FLEX, and CSS
-- BLOCKIFIES the children of a flex container — so `strong` / `em` / `sub` /
-- `sup` / `abbr` inside a `row` or `column` compute to `display: block` and
-- stack instead of flowing inline, no matter what their own rule says. Put them
-- in a `prose` box (the only non-flex text container) to get real inline flow.
style prose with
  display = block
  text-color = slate_90
end

-- `strong` / `emphasis` are ELEMENTS (they mean importance / stress emphasis);
-- `bold` / `italic` are the purely visual CLASSES. Same rendering, different
-- meaning — mirroring HTML's own <strong>/<em> vs <b>/<i> split.
style strong with
  display = inline
  text-weight = 700
end

style emphasis with
  display = inline
  text-style = italic
end

style bold with
  text-weight = 700
end

style italic with
  text-style = italic
end

style underline with
  text-decoration-line = underline
end

style strikethrough with
  text-decoration-line = line-through
end

style code with
  font-family = ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace
  text-size = 0.875rem
  background-color = slate_30
  corner = 0.25rem
  padding = 0.125rem 0.375rem
end

style key with
  font-family = ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace
  text-size = 0.875rem
  background-color = slate_90
  text-color = slate_20
  corner = 0.25rem
  padding = 0.125rem 0.375rem
end

style highlight with
  background-color = amber_60
  text-color = slate_20
  padding = 0.0625rem 0.25rem
  corner = 0.125rem
end

style deleted with
  text-decoration = line-through
  text-color = slate_60
end

style inserted with
  text-decoration = underline
  text-color = emerald_60
end

style abbreviation with
  text-decoration = underline dotted
  cursor = help
end

-- `divider` renders an <hr>. The overlay's flex default would collapse it, so
-- it is an explicit block rule.
style divider with
  display = block
  width = 100%
  height = 0
  margin = 1rem 0
  border-width = 0
  border-top-width = 0.0625rem
  border-top-style = solid
  border-top-color = slate_40
end

style citation with
  text-style = italic
  text-color = slate_60
  text-size = 0.875rem
end

style quote with
  display = flex
  child-layout = column
  child-gap = 0.5rem
  margin = 1rem 0
  padding = 0.75rem 1.25rem
  border-left-width = 0.25rem
  border-left-style = solid
  border-left-color = slate_40
end

-- Lists ---------------------------------------------------------------------

-- `display` is stated explicitly rather than left to the browser default: the
-- overlay lays everything out as flex, and a flex `<li>` renders NO marker (a
-- marker needs `display: list-item`). `child-gap` likewise does nothing on a
-- non-flex parent, so list spacing is per-item margin.
style list with
  display = block
  padding-left = 1.5rem
  list-style = square
end

style ordered_list with
  display = block
  padding-left = 1.5rem
  list-style = decimal
end

style item with
  display = list-item
  text-color = slate_90
  margin-bottom = 0.25rem
end

-- Tables --------------------------------------------------------------------

-- The table family needs its native display values spelled out: the overlay
-- lays every element out as FLEX, and a flex table/row/cell does no table
-- layout at all (columns stop aligning across rows).
style table_header with
  display = table-header-group
end

style table_body with
  display = table-row-group
end

style table_footer with
  display = table-footer-group
end

style table_row with
  display = table-row
end

style table with
  display = table
  width = 100%
  border-collapse = collapse
  text-align = left
  margin = 1rem 0
end

style header_cell with
  display = table-cell
  padding = 0.75rem 1rem
  text-weight = 600
  text-color = slate_90
  border-bottom-width = 0.125rem
  border-bottom-style = solid
  border-bottom-color = slate_40
end

style cell with
  display = table-cell
  padding = 0.75rem 1rem
  text-color = slate_90
  border-bottom-width = 0.0625rem
  border-bottom-style = solid
  border-bottom-color = slate_40
end

-- `table striped` tints alternate BODY rows. `@odd` is the nth-child alias, so
-- this needs no per-row authoring.
style striped with
  > table_body:
    > @odd:
      background-color = slate_20
end

-- A horizontal scroll box for a table too wide for its container. The overlay
-- makes everything flex, so `display` is stated explicitly.
style overflow_auto with
  display = block
  overflow-x = auto
  width = 100%
end

-- Structure -----------------------------------------------------------------

-- Pico's article is a card whose own `header`/`footer` are tinted sectioning
-- bands separated by a rule, so they are targeted as direct children.
style article with
  display = flex
  child-layout = column
  child-gap = 1rem
  background-color = slate_30
  corner = 0.5rem
  padding = 1.5rem
  margin = 1rem 0
  > header:
    margin = -1.5rem -1.5rem 0
    padding = 1rem 1.5rem
    background-color = slate_20
    border-bottom-width = 0.0625rem
    border-bottom-style = solid
    border-bottom-color = slate_40
    corner-top-left = 0.5rem
    corner-top-right = 0.5rem
  > footer:
    margin = 0 -1.5rem -1.5rem
    padding = 1rem 1.5rem
    background-color = slate_20
    border-top-width = 0.0625rem
    border-top-style = solid
    border-top-color = slate_40
    corner-bottom-left = 0.5rem
    corner-bottom-right = 0.5rem
  -- An `article #aria-busy=true` with no children is Pico's block-level
  -- loading placeholder: just a centred spinner.
  @busy:
    child-align = center
    child-justify = center
    min-height = 4rem
    @before:
      content = ""
      width = 1.25rem
      height = 1.25rem
      corner = 50%
      border-width = 0.125rem
      border-style = solid
      border-color = var(--theme-color-slate_40)
      border-top-color = var(--theme-color-sky_60)
      animation-name = spin
      animation-duration = 0.6s
      animation-timing-function = linear
      animation-iteration-count = infinite
end

style header with
  display = flex
  child-layout = column
  child-gap = 0.5rem
end

style footer with
  display = flex
  child-layout = column
  child-gap = 0.5rem
  text-color = slate_60
  text-size = 0.875rem
end

style section with
  display = flex
  child-layout = column
  child-gap = 1rem
end

style form with
  display = flex
  child-layout = column
  child-gap = 1rem
end

-- Pico strips the default fieldset chrome and uses it purely as a grouping box.
style field_group with
  display = flex
  child-layout = column
  child-gap = 0.5rem
  border-width = 0
  padding = 0
  margin = 0
end

style group_label with
  text-weight = 600
  padding-bottom = 0.5rem
end

-- Accordion: a native <details>/<summary> disclosure.
style disclosure with
  display = block
  border-bottom-width = 0.0625rem
  border-bottom-style = solid
  border-bottom-color = slate_40
  padding = 0.75rem 0
end

style disclosure_label with
  display = list-item
  cursor = pointer
  text-weight = 600
  text-color = slate_90
end

-- Modal: authored as `modal`, rendering a native <dialog>, opened
-- declaratively with `#open={flag}`. Deliberately NOT called `dialog` — the
-- screenplay `dialogue` style (character speech) is a different thing one
-- letter away.
--
-- Follows Pico's shape — the DIALOG is the full-screen scrim and the `article`
-- inside it is the card — so a modal is authored as:
--
--   dialog #open={show}:
--     article:
--       ...
--
-- A `<dialog>` with no `open` attribute is `display: none` natively, but the
-- base rule here has to restate that: setting `display: flex` unconditionally
-- would make a CLOSED modal visible.
style modal with
  display = none
  position = fixed
  anchor = 0
  z = 999
  child-align = center
  child-justify = center
  padding = 1rem
  border-width = 0
  background-color = rgb(0 0 0 / 50%)
  text-color = slate_90
  @opened:
    display = flex
end

style card with
  display = flex
  child-layout = column
  child-gap = 1rem
  background-color = slate_30
  corner = 0.5rem
  padding = 1.5rem
  border-width = 0.0625rem
  border-style = solid
  border-color = slate_40
end

style nav with
  display = flex
  child-layout = row
  child-align = center
  child-gap = 1rem
end

-- `secondary` / `contrast` / `outline` carry no styling of their own — they are
-- MODIFIERS, and each element defines what they mean via compound selectors
-- (see `button` and `link`). Defining them standalone is what previously made
-- `link secondary` render as a filled button.

style badge with
  display = flex
  child-layout = row
  child-align = center
  child-justify = center
  padding = 0.125rem 0.5rem
  corner = 1rem
  background-color = sky_60
  text-color = white
  text-size = 0.75rem
  text-weight = 600
end

-- Pico's `group` JOINS its children into one control (a field welded to its
-- button): no gap, and the inner corners squared off so they read as a single
-- unit. Use a plain `row #child-gap=…` for merely spaced children.
style group with
  display = flex
  child-layout = row
  child-gap = 0
  > @first:
    corner-top-right = 0
    corner-bottom-right = 0
  > @last:
    corner-top-left = 0
    corner-bottom-left = 0
end

-- Pico's `.grid` auto-fits however many children it has into ONE row of equal
-- columns (a fixed `1fr 1fr` wrapped a 3-up form onto two lines). `minmax(0,1fr)`
-- rather than plain `1fr` so a long child can shrink instead of overflowing.
style grid with
  child-layout = grid
  child-columns = repeat(auto-fit, minmax(0, 1fr))
  child-gap = 1rem
end

-- A native <progress value max>. `accent-color` is what tints the filled part
-- of the native control; `progress_fill` below stays available for the
-- div-track-plus-fill construction.
style progress with
  display = inline-block
  width = 100%
  height = 0.5rem
  corner = 0.25rem
  background-color = slate_30
  accent-color = sky_60
  border-width = 0
end

style progress_fill with
  height = 100%
  corner = 0.25rem
  background-color = sky_60
end

style label with
  text-weight = 500
  text-size = 0.875rem
end

style hint with
  text-color = slate_60
  text-size = 0.875rem
end

style invalid with
  border-color = red_60
end

style valid with
  border-color = green_60
end

style textbox with
  position = absolute
  bottom = 0
  left = 0
  right = 0
  display = flex
  flex_direction = column
  align_items = center
  color = white
  flex = 1
end

style textbox_background with
  position = absolute
  inset = 0
  background_image = linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.5) 25%, rgba(0, 0, 0, 1) 100%)
end

style textbox_content with
  position = relative
  flex = 1
  display = flex
  flex_direction = column
  max_width = 800px
  width = 100%
  margin = 0 auto
  min_height = 200px
  padding = 16px 32px
  @screen_size(sm):
    min_height = 240px
    padding = 16px
end

style character_info with
  display = flex
  flex_direction = row
  justify_content = center
  align_items = flex-end
  gap = 8px
  line_height = 1
  font_size = 1.875rem
  @screen_size(sm):
    font_size = 1.5rem
end

style character_name with
  padding_bottom = 8px
  font_weight = 600px
end

style character_parenthetical with
  padding_bottom = 8px
  font_weight = 400px
  font_size = 1rem
  @screen_size(sm):
    font_size = 0.875rem
end

style title with
  position = absolute
  inset = 0
  padding_left = 40px
  padding_right = 40px
  display = flex
  flex_direction = column
  justify_content = center
  align_self = center
  text_align = center
  font_weight = bold
end

style heading with
  position = absolute
  inset = 0
  padding_left = 40px
  padding_right = 40px
  display = flex
  flex_direction = column
  justify_content = center
  align_self = center
  text_align = center
  font_weight = bold
end

style transitional with
  position = absolute
  inset = 0
  padding_left = 40px
  padding_right = 40px
  padding_bottom = 24px
  display = flex
  flex_direction = column
  justify_content = center
  align_self = flex-end
  text_align = right
  width = 100%
end

style dialogue with
  margin = 0 auto
  width = 68%
  @screen_size(sm):
    width = 80%
end

style action with
  position = absolute
  inset = 0
  padding_left = 40px
  padding_right = 40px
  display = flex
  flex_direction = column
  justify_content = center
  align_self = center
  text_align = center
end

style continue_indicator with
  opacity = 0
  line_height = 1
  width = 16px
  height = 16px
  position = absolute
  right = 16px
  bottom = 16px
  font_size = 16px
  transition = opacity 0.25s linear
  animation = 0.5s infinite bounce
  animation_play_state = paused
end

define screen with
  ["$recursive"] = true
end

layout loading with
  loading_bar:
    loading_fill:
end

layout main with
  stage:
    animation:
    backdrop:
      image = transparent
    portrait:
      image:
  choices:
    choice 0:
      text:
    choice 1:
      text:
    choice 2:
      text:
    choice 3:
      text:
    choice 4:
      text:
    choice 5:
      text:
  textbox:
    textbox_background:
    textbox_content:
      character_info:
        character_name:
          stroke:
          text:
        character_parenthetical:
          stroke:
          text:
      title:
        stroke:
        text:
      heading:
        stroke:
        text:
      transitional:
        stroke:
        text:
      dialogue:
        stroke:
        text:
      action:
        stroke:
        text:
    continue_indicator:
      text = ▼
  screen:
    animation:
end

define layer with
end

define self as layer with
end

define instance as layer with
end

define object as layer with
end

define animation with
  target = layer.self
  keyframes = {}
  timing = { delay = 0, duration = 0, easing = "ease", iterations = 1, fill = "both", direction = "normal" }
end

animation show with
  target = layer.self
  keyframes:
    -
      opacity = "1"
  timing:
    delay = 0
    duration = 0
    easing = "linear"
    iterations = 1
    fill = "both"
    direction = "normal"
end

animation hide with
  target = layer.self
  keyframes:
    -
      opacity = "0"
  timing:
    delay = 0
    duration = 0
    easing = "linear"
    iterations = 1
    fill = "both"
    direction = "normal"
end

animation align_left with
  target = layer.instance
  keyframes:
    -
      translate = "calc(0 * (100cqw - 100%)) 0"
  timing:
    delay = 0
    duration = 0
    easing = "ease-in-out"
    iterations = 1
    fill = "both"
    direction = "normal"
