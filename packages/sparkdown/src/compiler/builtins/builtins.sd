  delay = { on = false, length = 0.15, strength = 0.5, feedback = 0.75 }
  reverb = { on = false, room_size = 0.5, mix = 0.5, damping = 0.5 }
  lowpass = { on = false, cutoff = 4000, cutoff_ramp = 0, resonance = 0.5 }
end

define mixer with
  gain = 1
end

define main as mixer with
  gain = 1
end

define music as mixer with
  gain = 1
end

define sound as mixer with
  gain = 1
end

define voice as mixer with
  gain = 1
end

define typewriter as mixer with
  gain = 1
end

define channel with
  mixer = mixer.none
  loop = false
  play_behavior = "replace"
end

define music as channel with
  mixer = "music"
  loop = true
  play_behavior = "replace"
end

define ambient as channel with
  mixer = "sound"
  loop = true
  play_behavior = "stack"
end

define sound as channel with
  mixer = "sound"
  loop = false
  play_behavior = "stack"
end

define voice as channel with
  mixer = "voice"
  loop = false
  play_behavior = "replace"
end

define typewriter as channel with
  mixer = "sound"
  loop = false
  play_behavior = "replace"
end

define typewriter with
  ["$link"] = { image = {}, audio = {}, synth = {}, character = {}, inflection = {}, prosody = {} }
  fade_duration = 0
  animation_offset = 0.06
  letter_pause = 0
  phrase_pause_scale = 5
  em_dash_pause_scale = 16
  stressed_pause_scale = 10
  punctuated_pause_scale = 15
  min_syllable_length = 3
  voiced = @/([\p{L}\p{N}']+)/u
  yelled = @/^([\p{Lu}]{2,}[^\p{Ll}\r\n]*)$/u
  punctuated = @/(?:^|\s)(?:[.]\s*?)+(?:$|\s)/u
end

