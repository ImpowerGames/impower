animation align_center with
  target = layer.instance
  keyframes:
    -
      translate = "calc(0.5 * (100cqw - 100%)) 0"
  timing:
    delay = 0
    duration = 0
    easing = "ease-in-out"
    iterations = 1
    fill = "both"
    direction = "normal"
