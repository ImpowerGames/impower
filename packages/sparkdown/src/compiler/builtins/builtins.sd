define channel with
  mixer = mixer.none
  loop = false
  play_behavior = "replace"
end

define music as channel with
  mixer = "music"
  loop = true
  play_behavior = "replace"
end

define ambient as channel with
  mixer = "sound"
  loop = true
  play_behavior = "stack"
end

define sound as channel with
  mixer = "sound"
  loop = false
  play_behavior = "stack"
end

define voice as channel with
  mixer = "voice"
  loop = false
  play_behavior = "replace"
end

define typewriter as channel with
  mixer = "sound"
  loop = false
  play_behavior = "replace"
end

define typewriter with
  ["$link"] = { image = {}, audio = {}, synth = {}, character = {}, inflection = {}, prosody = {} }
  fade_duration = 0
