-- Halfway between slate_40 and slate_50, like slate_65 and slate_75 below.
-- Exists because the switch's OFF track wants its own step: it was borrowing
-- the form-element border colour, which meant a project retinting its inputs
-- silently moved the switch too, and the two have no reason to agree.
define slate_45 as color with
  value = "rgb(61,75,95)"
