Call values {f()}.
Plain value {g()}.

function f()
  local calls = 0
  local order = ""
  local function read(value)
    calls += 1
    order ..= tostring(value)
    return value
  end
  local x0, x1, x2, x3, x4, x5, x6, x7 =
    read(1),
    read(2),
    read(3),
    read(4),
    read(5),
    read(6),
    read(7),
    read(8)
  return tostring(x0) .. tostring(x1) .. tostring(x2) .. tostring(x3) .. tostring(x4) .. tostring(x5) .. tostring(x6) .. tostring(x7) .. ":" .. order .. ":" .. tostring(calls)
end

function g()
  local x =
    1
  return x
end
