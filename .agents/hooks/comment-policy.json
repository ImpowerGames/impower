{
  "directives": [
    { "form": "^@ts-(?:expect-error|ignore|check|nocheck)\\b" },
    { "form": "^eslint-(?:disable|enable)(?:-next-line|-line)?\\b" },
    { "form": "^prettier-ignore\\b" },
    { "form": "^biome-ignore\\b" },
    { "form": "^(?:c8|v8|istanbul) ignore\\b" },
    { "form": "^@vitest-environment\\s+\\S", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^@vite-ignore$", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^/\\s*<(?:reference|amd-module|amd-dependency)\\b", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^@(?:type|param|returns?|property|prop)\\s*\\{", "extensions": [".js", ".mjs", ".cjs"] },
    { "form": "^@type\\s+[A-Za-z_$]", "extensions": [".js", ".mjs", ".cjs"] },
    { "form": "^@(?:typedef|template)\\b", "extensions": [".js", ".mjs", ".cjs"] },
    { "form": "^lookaround:", "extensions": [".yaml", ".yml"] },
    { "form": "^value-level:", "extensions": [".ts"] },
    { "form": "^not a node name$", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^Luau: [A-Za-z_][\\w.*]*(?: \\(adapted\\))?(?: / [A-Za-z_][\\w.*]*(?: \\(adapted\\))?)*(?: /)?$", "extensions": [".ts"] },
    { "form": "^Sparkdown-specific$", "extensions": [".ts"] },
    { "form": "^agent-tooling-(?:timeout-ms|serial):", "extensions": [".js", ".mjs", ".cjs"] }
  ],
  "licences": [
    { "form": "\\bSPDX-(?:License-Identifier|FileCopyrightText):\\s*\\S" },
    { "form": "^(?:Copyright\\b|©)(?:\\s*\\([cC]\\))?\\s*\\S" },
    { "form": "(?<![\\w./-])(?:[\\w.-]+/)*LICEN[CS]E(?:\\.[A-Za-z]+|-[\\w.-]*\\w)?(?![\\w-])" },
    { "form": "\\bThis\\s+Source\\s+Code\\s+Form\\s+is\\s+subject\\s+to\\s+the\\s+terms\\s+of\\s+the\\s+Mozilla\\s+Public\\s+License\\b" },
    { "form": "\\bLicensed\\s+under\\s+the\\s+Apache\\s+License\\b" },
    { "form": "\\bPermission\\s+is\\s+hereby\\s+granted,\\s+free\\s+of\\s+charge\\b" },
    { "form": "\\bRedistribution\\s+and\\s+use\\s+in\\s+source\\s+and\\s+binary\\s+forms\\b" }
  ],
  "platforms": ["chromium", "firefox", "safari", "webkit", "node", "windows", "macos", "linux", "android", "ios", "powershell", "bash", "typescript", "git", "github", "vscode"],
  "exempt": [
    "packages/sparkdown/src/inkjs/",
    "packages/sparkdown/src/tests/luau-conformance/upstream/",
    "packages/sparkdown/src/txml/",
    "packages/sparkdown/vendor/",
    "packages/spark-evaluate/src/_modules/",
    "packages/spec-component/src/idiomorph/",
    "packages/spark-engine/src/game/core/types/",
    "impower-dev/src/modules/spark-editor/workspace/types/RemoteStorageTypes.ts",
    "impower-app/"
  ]
}
