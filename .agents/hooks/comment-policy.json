    { "form": "\\bCopyright\\s*(?:\\([cC]\\)|©|\\d{4})" },
    { "form": "©\\s*(?:\\d{4}|[A-Z])" },
    { "form": "\\bThis Source Code Form is subject to the terms of the Mozilla Public License\\b" },
    { "form": "\\b(?:[Rr]eleased|[Ll]icen[cs]ed|[Dd]istributed|[Cc]overed|[Aa]vailable|[Pp]rovided) (?:under|by) (?:the )?(?:terms of (?:the )?)?(?:MIT|MPL|Mozilla Public|Apache|BSD|L?GPL|GNU|ISC|CC|Creative Commons)\\b" },
    { "form": "\\b(?:MIT|MPL|Apache|BSD|L?GPL|ISC)-licen[cs]ed\\b" },
    { "form": "^(?:The )?(?:MIT|ISC|Apache|BSD(?:[- ]\\d-Clause)?|Mozilla Public|GNU (?:Lesser )?General Public|L?GPL)(?: [\\d.]+)? Licen[cs]e(?:,? [Vv]ersion [\\d.]+)?\\.?$" },
    { "form": "\\b(?:Permission is hereby granted|THE SOFTWARE IS PROVIDED|The above copyright notice|Redistribution and use in source and binary forms|WITHOUT WARRANT(?:Y|IES) OF ANY KIND|All rights reserved|Licensed under the Apache License)" },
    { "form": "(?<![\\w-])LICEN[CS]E[-.][\\w.-]*\\w(?![\\w-])" },
    { "form": "\\b(?:[Ss]ee|in) (?:the )?`?LICEN[CS]E`?(?: file)?(?![\\w-])" }
  ],
  "platforms": ["chromium", "firefox", "safari", "webkit", "node", "windows", "macos", "linux", "android", "ios", "powershell", "bash", "typescript", "git", "github", "vscode"],
  "exempt": [
