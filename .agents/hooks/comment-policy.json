{
  "directives": [
    { "form": "^@ts-(?:expect-error|ignore|check|nocheck)\\b" },
    { "form": "^eslint-(?:disable|enable)(?:-next-line|-line)?\\b" },
    { "form": "^prettier-ignore\\b" },
    { "form": "^biome-ignore\\b" },
    { "form": "^(?:c8|v8|istanbul) ignore\\b" },
    { "form": "^@vitest-environment\\s+\\S", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^@vite-ignore$", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^/\\s*<(?:reference|amd-module|amd-dependency)\\b", "extensions": [".ts", ".tsx", ".js", ".mjs", ".cjs"] },
    { "form": "^@(?:type|param|returns?)\\s*\\{", "extensions": [".js", ".mjs", ".cjs"] },
    { "form": "^@(?:typedef|template)\\b", "extensions": [".js", ".mjs", ".cjs"] },
    { "form": "^lookaround:", "extensions": [".yaml", ".yml"] },
    { "form": "^value-level:", "extensions": [".ts"] },
    { "form": "^agent-tooling-(?:timeout-ms|serial):", "extensions": [".js", ".mjs", ".cjs"] }
  ],
  "licences": [
