component card(title) {
  heading {
    text
  }
}

layout board {
  stage {
    backdrop { image }
    portrait {
      image
    }
    poster {
      image #src="poster.png"
    }
  }
  panel {
    caption {
      stroke
      text
    }
    sign {
      text "Open"
    }
    stamp {
      text = ■
    }
    label {
      note.text
    }
    badge #clear {
      text
    }
    frame #gap=4 {
      mask {}
    }
    tile = {
      text
    }
    joined
    { image }
    continued
      #gap=4 { text }
    holder {
      inner {
        text
      }
    }
  }
  list {
    for item in items do
      row.entry {
        text
      }
    end
    if shown then
      note {
        image
      }
    end
  }
  text
}

scene start
  Hello.
end
