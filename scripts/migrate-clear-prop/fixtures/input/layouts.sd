component card(title) {
  heading {
    text
  }
}

screen menu {
  caption {
    text
  }
  slot
}

layout board {
  stage {
    backdrop { image }
    portrait {
      image
    }
    poster {
      image #src="poster.png"
    }
  }
  panel {
    caption {
      stroke
      text
    }
    sign {
      text "Open"
    }
    stamp {
      text = ■
    }
    label {
      note.text
    }
    badge #clear {
      text
    }
    frame #gap=4 {
      mask {}
    }
    tile = {
      text
    }
    joined
    { image }
    continued
      #gap=4 { text }
    commented -- picture slot
    { image }
    slashed // a note
    { image }
    holder {
      inner {
        text
      }
    }
  }
  list {
    for item in items do
      row.entry {
        text
      }
    end
    if shown then
      note {
        image
      }
    end
  }
  text
}

layout chat {
  heading { text }
  thread {
    stream {
      dialogue.bubble { text }
    }
    stream.log #height=240px {
      dialogue.said {
        character_name { text }
        dialogue { text }
      }
      action.narrated { text }
    }
    caption { text }
  }
}

scene start
  Hello.
end
