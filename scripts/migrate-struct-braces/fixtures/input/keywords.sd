store ready = true

style panel with -- the panel's look
  text-color = white
  > text { text-size = 24px }
  @hovered { opacity = 0.5 }
end

animation flip as base with
  keyframes {
    to { transform = scaleX(-1) }
  }
end -- flips it

theme dusk with
  color = #112233
end

morph blink with
  method = bend
  keyframes {
    from { eyes { state = open } }
    to { eyes { state = closed } }
  }
end

layout title in menu as base with
  column #child-gap=16 {
    if ready then
      text "My Game"
    end
    for i = 1, 3 do
      button "Play {i}" @click=start
    end
  }
end

component card(title) as box with
  box.card { slot }
end

screen menu with end

screen pause with
end

scene start
  Hello.
end
