// Pico showcase — a one-to-one port of the Pico CSS example page
// (https://4mrnhq.csb.app), rendered by the reactive Sparkle engine.
//
// Paste this whole file into the editor to see it live, OR just open it: it is
// the fixture behind
// packages/spark-web-player/src/tests/ui/picoShowcase.test.ts, which compiles it
// WARNING-FREE and asserts the rendered DOM. Adding a section here is how a
// builtin earns CI coverage, so keep the two in sync.
//
// Element TAGS are builtins, named readably rather than after HTML — box, span,
// scroller, text, link, label, field, textarea, button, picture, input, slider,
// checkbox, radio, switch, dropdown, option, divider, progress, list,
// ordered_list, item, table + table_header/table_body/table_row/header_cell/cell,
// quote, citation, figure, caption, disclosure, disclosure_label, article, section, header,
// footer, form, field_group, group_label, modal.
//
// Everything ELSE on an element line is a style CLASS — `column`, `row`, `card`,
// `nav`, `badge`, `h1`, `muted`, `small`, `group`, `grid`, `container`, and the
// inline text classes `bold`, `italic`, `underline`, `strikethrough`,
// `highlight`, `key`, `code`. Note `strong` / `emphasis` are ELEMENTS, not
// classes: they carry meaning for assistive tech, whereas `bold` / `italic`
// are purely visual — the same split HTML draws between <strong>/<em> and
// <b>/<i>. So it is `link "Home"`, NOT `text link "Home"`:
// two tags on one line is a warning.
//
// Styling WITHIN a line uses rich-text tags instead: `text "a <b>bold</b> word"`.
//
// NOTE: `#href` takes relative/fragment URLs here — an absolute `https://` value
// hits a known grammar bug with `://` in a prop value.

store first_name = ""
store email = ""
store agreed = false
store search_term = ""
store when = ""
store at_time = ""
store swatch = "#0eaaaa"
store volume = 50
store size = ""
store modal_open = false
store busy = false
store done = 25

function set_first(event)
  first_name = event.value
end

function set_email(event)
  email = event.value
end

function set_agreed(event)
  agreed = event.checked
end

function set_search(event)
  search_term = event.value
end

function set_volume(event)
  volume = event.value
end

function set_size(event)
  size = event.value
end

function open_modal()
  modal_open = true
end

function close_modal()
  modal_open = false
end

function toggle_busy()
  busy = not busy
end

layout main with
  scroller #height=100% #overflow-y=auto:
    column container #child-gap=24 #padding=28:

      -- Header -------------------------------------------------------------
      header:
        -- Pico's nav dropdown is a `details` styled as a menu — the same
        -- element as an accordion, so it opens without any JavaScript.
        box nav:
          list:
            item:
              -- Pico calls this class `dropdown`; here that name is already the
              -- <select> ELEMENT, so the menu class is `menu`.
              disclosure menu:
                disclosure_label secondary "Theme" #role="button"
                list:
                  item:
                    link "Auto" #href="#"
                  item:
                    link "Light" #href="#"
                  item:
                    link "Dark" #href="#"
        text h1 "Pico"
        text muted "A pure HTML example, without dependencies."
      divider

      -- Preview ------------------------------------------------------------
      section:
        text h2 "Preview"
        text "Sed ultricies dolor non ante vulputate hendrerit. Vivamus sit amet suscipit sapien. Nulla iaculis eros a elit pharetra egestas."
        form:
          row grid #child-gap=12:
            -- `#aria-label` because the placeholder is the only visible label:
            -- a placeholder is not an accessible name.
            field #value={first_name} #placeholder="First name" #aria-label="First name" #required=true @input=set_first
            field #type="email" #value={email} #placeholder="Email address" #aria-label="Email address" #autocomplete="email" #required=true @input=set_email
            button "Subscribe"
          row #child-gap=8 #child-align=center:
            switch #checked={agreed} @change=set_agreed
            text "I agree to the "
            link "Privacy Policy" #href="#"

      -- Typography ---------------------------------------------------------
      section:
        text h2 "Typography"
        text "Aliquam lobortis vitae nibh nec rhoncus. Morbi mattis neque eget efficitur feugiat. Vivamus porta nunc a erat mattis, mattis feugiat turpis pretium. Quisque sed tristique felis."
        quote:
          text "Maecenas vehicula metus tellus, vitae congue turpis hendrerit non. Nam at dui sit amet ipsum cursus ornare."
          citation "- Phasellus eget lacinia"

        text h3 "Lists"
        list:
          item "Aliquam lobortis lacus eu libero ornare facilisis."
          item "Nam et magna at libero scelerisque egestas."
          item "Suspendisse id nisl ut leo finibus vehicula quis eu ex."
          item "Proin ultricies turpis et volutpat vehicula."

        text h3 "Inline text elements"
        row grid:
          link "Primary link" #href="#"
          link secondary "Secondary link" #href="#"
          link contrast "Contrast link" #href="#"
        -- The reference marks these up semantically, so they are ELEMENTS.
        -- `<u>` is explicitly non-semantic in HTML, so underline stays a class.
        row grid:
          strong "Bold"
          emphasis "Italic"
          text underline "Underline"
        row grid:
          text deleted "Deleted"
          text inserted "Inserted"
          text strikethrough "Strikethrough"
        row grid:
          text small "Small"
          text "Text <sub>Sub</sub>"
          text "Text <sup>Sup</sup>"
        row grid:
          text abbreviation "Abbr."
          text key "Kbd"
          text highlight "Highlighted"

        -- Inline RICH TEXT: UI Toolkit's tag vocabulary inside ONE `text`. This
        -- is what nested elements can't express — mixed styled runs inside a
        -- single flowing sentence.
        text "Cras <b>sit amet</b> maximus <i>risus</i>, with <u>underline</u>, <s>strikethrough</s>, <mark=amber_60>a highlight</mark> and <color=sky_60>colour</color> mid-sentence."

        text h3 "Heading 3"
        text "Integer bibendum malesuada libero vel eleifend. Fusce iaculis turpis ipsum, at efficitur sem scelerisque vel. Aliquam auctor diam ut purus cursus fringilla. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos."
        text h4 "Heading 4"
        text "Cras fermentum velit vitae auctor aliquet. Nunc non congue urna, at blandit nibh. Donec ac fermentum felis. Vivamus tincidunt arcu ut lacus hendrerit, eget mattis dui finibus."
        text h5 "Heading 5"
        text "Donec nec egestas nulla. Sed varius placerat felis eu suscipit. Mauris maximus ante in consequat luctus. Morbi euismod sagittis efficitur. Aenean non eros orci. Vivamus ut diam sem."
        text h6 "Heading 6"
        text "Ut sed quam non mauris placerat consequat vitae id risus. Vestibulum tincidunt nulla ut tortor posuere, vitae malesuada tortor molestie. Sed nec interdum dolor. Vestibulum id auctor nisi, a efficitur sem. Aliquam sollicitudin efficitur turpis, sollicitudin hendrerit ligula semper id. Nunc risus felis, egestas eu tristique eget, convallis in velit."

      -- Buttons ------------------------------------------------------------
      section:
        text h2 "Buttons"
        row grid:
          button "Primary"
          button secondary "Secondary"
          button contrast "Contrast"
        row grid:
          button outline "Primary outline"
          button outline secondary "Secondary outline"
          button outline contrast "Contrast outline"

      -- Form elements ------------------------------------------------------
      section:
        text h2 "Form elements"
        -- Order and labels follow the reference exactly.
        form:
          label "Search"
          input search #type="search" #value={search_term} #placeholder="Search" @input=set_search

          label "Text"
          field #placeholder="Text"
          text small "Curabitur consequat lacus at lacus porta finibus."

          label "Select"
          dropdown #value={size} #required=true @change=set_size:
            -- An empty-valued selected first option is the placeholder: with
            -- `#required` it cannot be submitted, so it reads as a prompt.
            option "Select…" #value="" #selected=true
            option "…"

          label "File browser"
          input file_input #type="file"

          label "Range slider"
          slider #value={volume} #min=0 #max=100 @input=set_volume

          -- Validation states are Pico's `aria-invalid`, not a class.
          label "Valid"
          field #placeholder="Valid" #aria-invalid=false
          label "Invalid"
          field #placeholder="Invalid" #aria-invalid=true
          label "Disabled"
          field #placeholder="Disabled" #disabled=true

          label "Date"
          input #type="date" #value={when}

          label "Time"
          input #type="time" #value={at_time}

          label "Color"
          input #type="color" #value={swatch}

          field_group:
            group_label "Checkboxes"
            row #child-gap=8 #child-align=center:
              checkbox #checked=true
              text "Checkbox"
            row #child-gap=8 #child-align=center:
              checkbox
              text "Checkbox 2"

          field_group:
            group_label "Radio buttons"
            row #child-gap=8 #child-align=center:
              radio #name="radio" #checked=true
              text "Radio button"
            row #child-gap=8 #child-align=center:
              radio #name="radio"
              text "Radio button 2"

          field_group:
            group_label "Switches"
            row #child-gap=8 #child-align=center:
              switch #checked=true
              text "Switch"
            row #child-gap=8 #child-align=center:
              switch #checked={agreed} @change=set_agreed
              text "Switch 2"

          row #child-gap=12:
            button secondary "Reset" #type="reset"
            button "Submit" #type="submit"

      -- Tables -------------------------------------------------------------
      section:
        text h2 "Tables"
        box overflow_auto:
          table striped:
            table_header:
              table_row:
                header_cell "#" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
                header_cell "Heading" #scope="col"
            table_body:
              -- The row number is a `header_cell` with `#scope="row"`, not a
              -- plain cell: it LABELS the row, so a screen reader announces it
              -- alongside each value in that row.
              table_row:
                header_cell "1" #scope="row"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
              table_row:
                header_cell "2" #scope="row"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
              table_row:
                header_cell "3" #scope="row"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"
                cell "Cell"

      -- Modal --------------------------------------------------------------
      section:
        text h2 "Modal"
        button contrast "Launch demo modal" @click=open_modal
        modal #open={modal_open}:
          article:
            header:
              text h3 "Confirm your action!"
            text "Cras sit amet maximus risus. Pellentesque sodales odio sit amet augue finibus."
            footer:
              row #child-gap=8:
                button secondary "Cancel" @click=close_modal
                button "Confirm" @click=close_modal

      -- Accordions ---------------------------------------------------------
      section:
        text h2 "Accordions"
        disclosure:
          disclosure_label "Accordion 1"
          text "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Pellentesque urna diam, tincidunt nec porta sed, auctor id velit. Etiam venenatis nisl ut orci consequat, vitae tempus quam commodo. Nulla non mauris ipsum. Aliquam eu posuere orci. Nulla convallis lectus rutrum quam hendrerit, in facilisis elit sollicitudin. Mauris pulvinar pulvinar mi, dictum tristique elit auctor quis. Maecenas ac ipsum ultrices, porta turpis sit amet, congue turpis."
        disclosure #open=true:
          disclosure_label "Accordion 2"
          list:
            item "Vestibulum id elit quis massa interdum sodales."
            item "Nunc quis eros vel odio pretium tincidunt nec quis neque."
            item "Quisque sed eros non eros ornare elementum."
            item "Cras sed libero aliquet, porta dolor quis, dapibus ipsum."

      -- Article ------------------------------------------------------------
      section:
        text h2 "Article"
        article:
          text "Nullam dui arcu, malesuada et sodales eu, efficitur vitae dolor. Sed ultricies dolor non ante vulputate hendrerit. Vivamus sit amet suscipit sapien. Nulla iaculis eros a elit pharetra egestas. Nunc placerat facilisis cursus. Sed vestibulum metus eget dolor pharetra rutrum."
          footer:
            text small "Duis nec elit placerat, suscipit nibh quis, finibus neque."

      -- Figure -------------------------------------------------------------
      section:
        text h2 "Figure"
        figure:
          -- A remote `#src` resolves through the `.url` asset path; `#alt` is
          -- required for anything that is not purely decorative.
          picture #src="img/landscape.jpg" #alt="Minimal landscape"
          caption:
            text "Image from "
            link "unsplash.com" #href="#"

      -- Group --------------------------------------------------------------
      section:
        text h2 "Group"
        form:
          row group:
            field #placeholder="Enter your email"
            button "Subscribe"

      -- Progress -----------------------------------------------------------
      section:
        text h2 "Progress bar"
        progress #value={done} #max=100
        progress

      -- Loading ------------------------------------------------------------
      section:
        text h2 "Loading"
        -- A bare busy `article` is Pico's block-level loading placeholder.
        article #aria-busy=true
        row #child-gap=8 #child-align=center:
          button "Please wait…" #aria-busy={busy} @click=toggle_busy
          text muted "Click to toggle aria-busy"
end
